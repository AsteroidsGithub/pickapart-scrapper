{
    "name": "pickapart-scrapper",
    "version": "1.0.0",
    "description": "Turn Pick-A-Part into usable information",
    "homepage": "https://github.com/AsteroidsGithub/pickapart-scrapper#readme",
    "bugs": {
        "url": "https://github.com/AsteroidsGithub/pickapart-scrapper/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AsteroidsGithub/pickapart-scrapper.git"
    },
    "license": "GPL-3.0-only",
    "author": "Jonathan Voss",
    "main": "index.js",
    "type": "module",
    "engines": {
        "node": ">= 24.11 < 25"
    },
    "devDependencies": {
        "@eslint/js": "~10.0.1",
        "@types/node": "~24",
        "@typescript-eslint/parser": "~8.59.0",
        "@vitest/coverage-v8": "~4.1.4",
        "@vitest/eslint-plugin": "~1.6.15",
        "eslint": "~10.2",
        "eslint-config-prettier": "~10.1",
        "globals": "~17.5.0",
        "prettier": "~3.8",
        "rimraf": "~6.1.3",
        "ts-api-utils": "~2.5.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "~8.59.0",
        "vitest": "~4.1.11"
    },
    "scripts": {
        "start": "node build/main.js",
        "clean": "rimraf coverage build tmp",
        "prebuild": "npm run lint && npm run check-types",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "build": "tsc -p tsconfig.json",
        "build:watch": "tsc -w -p tsconfig.json",
        "build:release": "npm run clean && tsc -p tsconfig.release.json",
        "lint": "eslint .",
        "test": "vitest run unit --config __tests__/vitest.config.ts",
        "test:coverage": "vitest run unit --config __tests__/vitest.config.ts --coverage.enabled --coverage.all",
        "test:watch": "vitest unit --config __tests__/vitest.config.ts",
        "prettier": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --write",
        "prettier:check": "prettier \"{src,__{tests}__}/**/*.{ts,mts}\" --config .prettierrc --check"
    },
    "dependencies": {
        "cheerio": "^1.2.0",
        "crawlee": "^3.17.0",
        "tslib": "~2.8"
    }
}
